# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Database Configuration (PostgreSQL)
# Either set DATABASE_URL directly, or the individual POSTGRES_* vars below.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=veka_bot
POSTGRES_USER=veka_bot_user
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://veka_bot_user:your_secure_password_here@postgres:5432/veka_bot

# Access control — no user IDs in the environment.
# Operators = Discord Developer Portal team members with the Admin/Developer role; manage them
# in the portal (no deploy). Server admin/staff/perk roles: dashboard or `/setup roles`.
# Operational alert channel: `/operator alerts channel:<#channel>` (stored in the database).

# Stdout is the default, including non-root/read-only containers.
# Set 1 only for local development if you want rotating logs/bot.log.
VEKA_LOG_TO_FILE=0

# Configure server feature channels with /setup or the dashboard, not environment variables.

# Canonical core integration. All three values are required to enable submissions.
# Installation ID is the stable service_keys.name returned with the scoped service key.
VEKA_CORE_URL=http://veka-core:8090
VEKA_CORE_SERVICE_KEY=
VEKA_CORE_INSTALLATION_ID=

# Dynamic RSS feeds (/feed add|edit|pause|resume|remove|list|test)
# Limits include paused subscriptions. Polling intervals: 10–1440 minutes.
FEED_MAX_SUBSCRIPTIONS=25
FEED_MAX_POSTS_PER_POLL=3
# Total automatic posts per server per one-minute scheduler cycle
FEED_MAX_POSTS_PER_GUILD_PER_CYCLE=15

# Bot Configuration
BOT_VERSION=1.0.0
LOG_LEVEL=INFO
ENVIRONMENT=development
# ENVIRONMENT=production

# Dashboard API (separate `api` container; all optional for the bot).
# Shared secret for server-to-server calls from the website; generate with `openssl rand -hex 32`.
# API_SERVICE_TOKEN=
# Browser origins allowed to call the API directly (comma-separated). Not needed for server-side calls.
# API_CORS_ORIGINS=https://veka.gg
# Reverse proxies whose X-Forwarded-For is trusted (IPs or CIDRs, comma-separated).
# API_TRUSTED_PROXIES=172.16.0.0/12
# API_RATE_LIMIT=120
# API_PREAUTH_LIMIT=60

# Privacy (optional). Link shown by /privacy; retention periods in days (defaults match the published policy).
# VEKA_BOT_POLICY_URL=https://veka.gg/legal/bots
# RETENTION_MODERATION_DAYS=730
# RETENTION_AUDIT_LOG_DAYS=730
# RETENTION_INACTIVITY_NOTICE_DAYS=400
# RETENTION_DEPARTED_GUILD_DAYS=30
