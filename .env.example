# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Database Configuration (PostgreSQL)
# Either set DATABASE_URL directly, or the individual POSTGRES_* vars below.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=veka_bot
POSTGRES_USER=veka_bot_user
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://veka_bot_user:your_secure_password_here@postgres:5432/veka_bot

# Access Control (comma-separated Discord user IDs)
ADMIN_IDS=123456789,987654321
OWNER_IDS=123456789
FOUNDER_IDS=123456789
STAFF_IDS=
INTERN_IDS=
DONATOR_IDS=
ACTIVE_PRO_IDS=

# Operational alerts channel (Discord channel ID)
ADMIN_ALERT_CHANNEL_ID=

# Configure server feature channels with /setup or the dashboard, not environment variables.

# Main VEKA server (full functionality available here)
MAIN_GUILD_ID=1088553066334273537
MAIN_SERVER_INVITE_URL=https://discord.gg/veka

# Directus CMS Sync (marketplace listings mirror for web frontend)
# Leave blank to disable sync entirely.
DIRECTUS_URL=https://your-directus-instance.example.com
DIRECTUS_SERVICE_TOKEN=your_directus_service_token_here

# Dynamic RSS feeds (/feed add|edit|pause|resume|remove|list|test)
# Limits include paused subscriptions. Polling intervals: 10–1440 minutes.
FEED_MAX_SUBSCRIPTIONS=25
FEED_MAX_POSTS_PER_POLL=3
# Total automatic posts per server per one-minute scheduler cycle
FEED_MAX_POSTS_PER_GUILD_PER_CYCLE=15

# Bot Configuration
BOT_VERSION=1.0.0
LOG_LEVEL=INFO
ENVIRONMENT=development
# ENVIRONMENT=production

# Dashboard API (separate `api` container; all optional for the bot). See docs/DASHBOARD_API_DEPLOY.md.
# Shared secret for server-to-server calls from the website; generate with `openssl rand -hex 32`.
# API_SERVICE_TOKEN=
# Browser origins allowed to call the API directly (comma-separated). Not needed for server-side calls.
# API_CORS_ORIGINS=https://veka.gg
# Reverse proxies whose X-Forwarded-For is trusted (IPs or CIDRs, comma-separated).
# API_TRUSTED_PROXIES=172.16.0.0/12,192.168.1.97
# API_RATE_LIMIT=120
# API_PREAUTH_LIMIT=60
# Where docker compose publishes the API port: 127.0.0.1 (this machine only) or this machine's LAN IP.
# API_BIND_ADDRESS=127.0.0.1
# API_PUBLISHED_PORT=8080
